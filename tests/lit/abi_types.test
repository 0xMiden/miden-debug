# CHECK-SAME: array=[5, 6, 7]
# CHECK-SAME: enabled=true
# CHECK-SAME: maybe=OptionU32::Some(42)
# CHECK-SAME: point={x=3, y=4}
# CHECK-SAME: wide=u256([1, 2, 3, 4, 5, 6, 7, 8])
