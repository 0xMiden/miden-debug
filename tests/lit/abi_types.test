# Render ABI-typed debug variables through the non-interactive REPL.
#
# RUN: compile-abi-fixture %S/abi_types.masm -o %t.masp
# RUN: miden-debug --commands %s %t.masp 2>&1 | filecheck %s

continue
vars all

