#!/bin/sh
set -eu

test "$1" = "build"
shift

profile=""
target_dir=""
manifest=""
target=""
entrypoint=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --target-dir)
            target_dir="$2"
            shift 2
            ;;
        --profile)
            profile="$2"
            shift 2
            ;;
        --manifest-path)
            manifest="$2"
            shift 2
            ;;
        --target)
            target="$2"
            shift 2
            ;;
        --entrypoint)
            entrypoint="$2"
            shift 2
            ;;
        *)
            exit 2
            ;;
    esac
done

test "$profile" = "debug"
test "$manifest" = "$PWD/miden-project.toml"
test "$target_dir" = "$PWD/target/miden-debug"
test "$target" = "project-aware"
test "$entrypoint" = "project_aware::entrypoint"
output="$target_dir/$profile/project-aware:project-aware.masp"
mkdir -p "$(dirname "$output")"
cp "$MIDEN_TEST_PACKAGE" "$output"
